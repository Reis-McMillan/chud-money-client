# Base URL of the chud-money backend. Websocket URLs are derived from it.
VITE_API_BASE=http://localhost:3000

# Verys auth service. Must be the same instance the backend's AUTH_URL points
# at. The compose Verys is on 8080 (its dev config hard-codes that issuer);
# prod is https://api.verys.mcmlln.dev.
VITE_VERYS_URL=http://localhost:8080
# This SPA's public (PKCE) client in Verys. Its redirect_uris must include
# ${origin}/auth/callback and ${origin}/ (the latter for sign-out). The values
# below are what scripts/verys-seed.js creates in the compose Verys, and what
# the app falls back to when a variable is unset.
VITE_VERYS_CLIENT_ID=chud-money-spa
# chud-money's Verys client id: the audience the login is exchanged for. Must
# equal the backend's CHUD_MONEY_API_CLIENT_ID, and that client's redirect_uris
# must also include ${origin}/auth/callback for the one-time consent step.
VITE_CHUD_MONEY_CLIENT_ID=chud-money-api
